# Copy to .env and paste YOUR OWN keys. .env is git-ignored. Never commit a key.
#   Copy-Item .env.example .env
#
# Gemini is needed for chat; OpenRouter is the fallback; LangSmith is for tracing and the scorecard.

# Gemini (chat model + embeddings): https://aistudio.google.com/apikey  (free)
GEMINI_API_KEY=

# OpenRouter (fallback chat model): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# LangSmith (tracing + scorecard): https://smith.langchain.com  -> Settings -> API keys
# Tracing is switched on per run with chat.py --langsmith (the scorecard and demo.py turn it on themselves).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=festguide
